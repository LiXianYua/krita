#pragma once
#include "../PkSqlQuery.h"

// 兼容垫片：让真实调用点的 `#include <QSqlQuery>` 在一个字都不改的前提下
// 解析到 PkSqlQuery。文件名刻意没有扩展名 —— 调用点写的就是 <QSqlQuery>。
//
// 用宏而不是 `using QSqlQuery = PkSqlQuery;`：与 compat/QSqlDatabase、
// compat/QSqlError 同一条理由——Krita 头文件里可能有 `class QSqlQuery;`
// 前置声明，类型别名遇到它会报 "redeclared as different kind of entity"，宏把
// 那一行原样改写成 `class PkSqlQuery;`，前置声明照样成立。
#define QSqlQuery PkSqlQuery
