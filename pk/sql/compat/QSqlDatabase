#include "../PkSqlDatabase.h"

// 兼容垫片：让真实调用点的 `#include <QSqlDatabase>` 在一个字都不改的前提下
// 解析到 PkSqlDatabase。文件名刻意没有扩展名 —— 调用点写的就是 <QSqlDatabase>。
//
// 用宏而不是 `using QSqlDatabase = PkSqlDatabase;`：与 pk/xml/compat/QDomDocument、
// pk/log/compat/QDebug 同一条理由——Krita 头文件里可能有 `class QSqlDatabase;`
// 前置声明，类型别名遇到它会报 "redeclared as different kind of entity"，宏把
// 那一行原样改写成 `class PkSqlDatabase;`，前置声明照样成立。
#define QSqlDatabase PkSqlDatabase
