#pragma once
// 兼容垫片：让真实调用点的 `#include <QScopedPointer>` 在一个字都不改的前提下
// 解析到 PkScopedPointer/PkScopedArrayPointer。文件名刻意没有扩展名——调用点
// 写的就是 <QScopedPointer>。做法照 pk/geometry/compat/QRect。
//
// **两个名字一起给**（与 compat/QRect 同形的先例）：真 Qt 的 qscopedpointer.h
// 一个头里同时定义 QScopedPointer 与 QScopedArrayPointer，`#include <QScopedPointer>`
// 之后直接用 QScopedArrayPointer 是合法调用点写法，只给一个名字会让那类调用点
// 编不过。
#include "../PkScopedPointer.h"

// 用宏而不是 `using`：与 compat/QSharedPointer 同因，Krita 里有
// `template <class T> class QScopedPointer;` 式前置声明，类型别名遇到它会报
// "redeclared as different kind of entity"。
#ifndef QScopedPointer
#define QScopedPointer PkScopedPointer
#endif
#ifndef QScopedArrayPointer
#define QScopedArrayPointer PkScopedArrayPointer
#endif
