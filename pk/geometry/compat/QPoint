#pragma once
#include "../PkPoint.h"

// 兼容垫片：让真实调用点的 `#include <QPoint>` 在**一个字都不改**的前提下解析到
// PkPoint。文件名刻意没有扩展名 —— 调用点写的就是 <QPoint>。做法照
// pk/string/compat/QString 的先例。
//
// 用宏而不是 `using QPoint = PkPoint;`：Krita 里有 `class QPoint;` 这类前置声明
//（如 libs/flake/KoCanvasBase.h），类型别名遇到它会报 "redeclared as different
// kind of entity"；宏则把那一行原样改写成 `class PkPoint;`，前置声明照样成立。
//
// **两个名字都在这里定义**，与 Qt 一致：Qt 的 <QPoint> 与 <QPointF> 都只是
// qpoint.h 的转发头，包任一个都能同时拿到 QPoint 与 QPointF，而 Krita 里
// `#include <QPoint>` 之后直接用 QPointF 的调用点是常态。
#ifndef QPoint
#define QPoint PkPoint
#endif
#ifndef QPointF
#define QPointF PkPointF
#endif
