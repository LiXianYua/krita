#pragma once

// pk/geometry 的 <QtGlobal> 垫片。**必须是 pk/test/compat/QtGlobal 的超集。**
//
// 试接时编译行同时有 -I pk/test/compat 与 -I pk/geometry/compat，而
// `#include <QtGlobal>` 只会命中其中一份（谁在 -I 里靠前谁赢）。命中本份时，
// pk/test 那份提供的东西（qAbs、qFuzzyCompare、qFuzzyIsNull）也必须在，
// 否则 harness 侧的调用点编不过。
//
// 做法：先把 pk/test 那份拉进本 TU —— 它用 #pragma once，之后 <QtGlobal> 再
// 解析到它就空转 —— 再包 PkGlobal.h。于是两份垫片以任意顺序进入同一个 TU
// 都不会重复定义 qAbs、也不会让那两个 #define 把函数名改写坏。
// pk/test 不在时（本工程单独构建、或将来搬走）__has_include 为假，
// PkGlobal.h 自己提供那三项，超集关系照样成立。
//
// 完整设计说明在 PkGlobal.h 顶部「与 pk/test/compat/QtGlobal 的共存」一节；
// **三种** include 顺序各有一个 TU 在 ../tests/coexist_*.cpp 里编译并核对取值。
//
// ⚠ **纪律：七个类型垫片（QPoint/QPointF/QSize/QSizeF/QRect/QRectF/QTransform）
//   必须在包各自的 Pk 头之前先包本文件。新增 compat 垫片照做。**
//
//   为什么：`#include <QRect>` 经过的是 **compat/QRect**，而 compat/QRect 直接包
//   ../PkRect.h → ../PkGlobal.h —— **绕开本文件**，机制 ② 不被触发。于是
//       libs/global/KisRectsGrid.h:10   #include <QRect>      → PkGlobal.h 自己定义 qAbs
//       libs/global/kis_assert.h:10     #include <QtGlobal>   → 本文件 → pk/test 那份
//   在同一个 TU 里撞出 "redefinition of 'template<class T> constexpr T qAbs'"。
//   这不是人造顺序：任何 Krita 测试 TU（-I 里必然有 pk/test/compat）只要先 include
//   一个几何头再 include <QtGlobal> 就走这条路，S-00 会踩满地。
//
//   先包本文件之后，无论调用点先写 <QRect> 还是先写 <QtGlobal>，pk/test 那份都
//   先落地、机制 ① 的 `#if defined(qFuzzyCompare)` 随即生效，PkGlobal.h 让位。
//   这既是修复也是对 Qt 的忠实复刻 —— 真 Qt 的每个公开头都以
//   `#include <QtCore/qglobal.h>` 开头（qrect.h:42 经 qmargins.h、qpoint.h:42 直接包）。
//
//   回归守卫：../tests/coexist_compat_rect_first.cpp（拿掉那行 include 它当场变红）。
//
// 本文件不提供 qint8..quint64 那批整数 typedef：R-03 的实测用量表里它们归
// R-02（容器），这里不预先实现（线级 spec 判据①）。

#if defined(__has_include)
#  if __has_include("../../test/compat/QtGlobal")
#    include "../../test/compat/QtGlobal"
#  endif
#endif

#include "../PkGlobal.h"
