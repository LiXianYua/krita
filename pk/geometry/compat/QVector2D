#pragma once
// 必须先于 ../PkVectorND.h，理由见 compat/QPoint 与 compat/QtGlobal 的 ⚠。
#include "QtGlobal"
#include "../PkVectorND.h"

// 兼容垫片：让真实调用点的 `#include <QVector2D>` 在**一个字都不改**的前提下解析到
// PkVector2D/PkVector3D/PkVector4D。做法照 compat/QRect。
//
// **三个名字一起给**：Qt 的 <QVector2D> / <QVector3D> / <QVector4D> 都是
// qvectornd 系的转发头，彼此独立但都声明在同一批数学头里（qvector2d.h 会前置
// 声明 QVector3D/QVector4D，qvector3d.h 会前置声明 QVector2D/QVector4D）。只
// 定义一个的话 `#include <QVector2D>` 之后用 QVector3D 的调用点会编不过。
// 形态与 compat/QLine + compat/QLineF、compat/QPolygon + compat/QPolygonF 对齐。
//
// `PkPoint`/`PkPointF`（三个类型的参数与返回类型，如 toPoint/toPointF 与
// PkVector2D(const PkPointF&) 构造）经 ../PkVectorND.h 一起进来。

#ifndef QVector2D
#define QVector2D PkVector2D
#endif
#ifndef QVector3D
#define QVector3D PkVector3D
#endif
#ifndef QVector4D
#define QVector4D PkVector4D
#endif
