#pragma once
// 必须先于 ../PkMargins.h，理由见 compat/QPoint 与 compat/QtGlobal 的 ⚠。
#include "QtGlobal"
#include "../PkMargins.h"

// 兼容垫片：让真实调用点的 `#include <QMargins>` 在**一个字都不改**的前提下
// 解析到 PkMargins。做法照 compat/QRect。
//
// **两个名字一起给**：Qt 的 <QMargins> 与 <QMarginsF> 都只是 qmargins.h 的
// 转发头，包任一个都能同时拿到两个名字——只定义一个的话
// `#include <QMargins>` 之后用 QMarginsF 的调用点会编不过。形态与
// compat/QRect + compat/QRectF 对齐。

#ifndef QMargins
#define QMargins PkMargins
#endif
#ifndef QMarginsF
#define QMarginsF PkMarginsF
#endif
