#pragma once
// 必须先于 ../PkRect.h，理由见 compat/QPoint 与 compat/QtGlobal 的 ⚠。
#include "QtGlobal"
#include "../PkRect.h"

// 兼容垫片：让真实调用点的 `#include <QRect>` 在**一个字都不改**的前提下解析到
// PkRect。文件名刻意没有扩展名 —— 调用点写的就是 <QRect>。做法照 compat/QPoint。
//
// 用宏而不是 `using QRect = PkRect;`：Krita 里有 `class QRect;` 这类前置声明
//（如 libs/flake/KoCanvasBase.h），类型别名遇到它会报 "redeclared as different
// kind of entity"；宏则把那一行原样改写成 `class PkRect;`，前置声明照样成立。
//
// **两个名字一起给**（Task 5 补齐）。Qt 的 <QRect> 与 <QRectF> 都只是 qrect.h 的
// 转发头，包任一个都能同时拿到 QRect 与 QRectF —— 只定义一个的话
// `#include <QRect>` 之后用 QRectF 的调用点会编不过。形态与 compat/QPoint、
// compat/QSize 对齐（那两份也都是两个名字一起给）。
//
// `PkPoint` / `PkSize` / `PkPointF` / `PkSizeF`（PkRect / PkRectF 的参数与返回
// 类型）经 ../PkRect.h 一起进来，与 Qt 的形态一致（qrect.h 自己
// #include <QtCore/qpoint.h> 与 <QtCore/qsize.h>）。
//
// **但只有类型进来还不够，`QPoint`/`QSize` 这四个名字也得进来。** Qt 的
// qrect.h:44-45 include 了 qsize.h 与 qpoint.h，所以真实调用点里
// `#include <QRect>` 之后直接写 `QSize` 是**合法的**，很多地方就是这么写的：
//   libs/global/kis_global.h:315  `QSize trimmedSize = QSize(width, ...)`
//   （那个文件只 include 了 <QPoint> <QPointF> 与（经 kis_algebra_2d.h 的）<QRect>）
// 少了下面这两行，那一处就报 "'QSize' was not declared in this scope"。
// **这是 Task 78 试接第一轮压出来的**，与 R-11 在 compat/QObject 里复刻
// "<QObject> 传递 include qglobal.h" 是同一类事：Qt 的传递 include 关系本身
// 就是调用点依赖的一部分，不复刻就会把"编不过"错误地记到调用点头上。
#include "QPoint"
#include "QSize"

#ifndef QRect
#define QRect PkRect
#endif
#ifndef QRectF
#define QRectF PkRectF
#endif
