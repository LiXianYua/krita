#pragma once
// 必须先于 ../PkPolygon.h，理由见 compat/QPoint 与 compat/QtGlobal 的 ⚠。
#include "QtGlobal"
#include "../PkPolygon.h"

// 兼容垫片：让真实调用点的 `#include <QPolygon>` 在**一个字都不改**的前提下
// 解析到 PkPolygon。做法照 compat/QRect。
//
// **两个名字一起给**：Qt 的 <QPolygon> 与 <QPolygonF> 都只是 qpolygon.h 的
// 转发头，包任一个都能同时拿到两个名字——只定义一个的话
// `#include <QPolygon>` 之后用 QPolygonF 的调用点会编不过。形态与
// compat/QLine + compat/QLineF、compat/QRect + compat/QRectF 对齐。
//
// `PkPoint`/`PkPointF`（PkPolygon/PkPolygonF 的元素类型）与 `PkRectF`
// （PkPolygonF(const PkRectF&) 构造）经 ../PkPolygon.h 一起进来（PkPolygon.h
// 自己 #include "PkPoint.h" 与 "PkRect.h"），与 Qt 的形态一致（qpolygon.h
// 自己 #include <QtCore/qpoint.h> 与 <QtCore/qrect.h>）。

#ifndef QPolygon
#define QPolygon PkPolygon
#endif
#ifndef QPolygonF
#define QPolygonF PkPolygonF
#endif
