#pragma once
// 试接垫片 —— **不是 R-03 的交付物**。`QLineF` 不在 R-03 的七个类型里，归属未定
// （与 QPolygonF 同处境，见 pk/geometry/README.md 的「覆盖度缺口」）。
//
// 为什么会撞上它：libs/global/kis_global.h:232 `#include <QLineF>`，紧接着两个
// **非模板** inline 函数 kisDistanceToLine / kisSquareDistanceToLine 用了
// line.p1() / line.p2()。非模板 inline 成员/函数在解析处就要通过语义检查，
// 哪怕一次都没被调用 —— 所以这两个成员必须真的存在，不能只前置声明 QLineF。
//
// 两个试接目标都**不调用**这两个函数，因此本垫片只做够它们编译的最小面：
// 默认构造、双点构造、p1()/p2()。不做 length/angle/intersects/unitVector 那些。
#include <QPointF>

class QLineF
{
public:
    QLineF() = default;
    QLineF(const QPointF &p1, const QPointF &p2) : m_p1(p1), m_p2(p2) {}

    QPointF p1() const { return m_p1; }
    QPointF p2() const { return m_p2; }

private:
    QPointF m_p1;
    QPointF m_p2;
};
