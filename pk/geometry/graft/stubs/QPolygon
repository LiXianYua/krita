#pragma once
// ============================================================================
// 试接垫片 —— **不是 R-03 的交付物**。`QPolygonF` 的**归属未定**：R-03 的七个
// 类型（PkPoint/PkPointF/PkSize/PkSizeF/PkRect/PkRectF/PkTransform）里没有它，
// R-02（容器）也没认领。见 pk/geometry/README.md 的「覆盖度缺口」。
//
// 调用点写的是 `#include <QPolygon>`（libs/image/kis_four_point_interpolator_
// forward.h:11 与 backward.h:11），真 Qt 的 <QPolygon> 同时给出 QPolygon 与
// QPolygonF，本垫片**只给 QPolygonF** —— 两个试接目标一次都没用整数版。
//
// 形态照真 Qt 5.15.7（QtGui/qpolygon.h）：`class QPolygonF : public QVector<QPointF>`。
// 照抄这个继承关系而不是自己包一层，是因为调用点用的 `polygon << QPointF(...)`、
// `polygon[1]`、`isEmpty()` 全是 QVector 的成员 —— 继承过来才不会漏。
//
// 真实调用点（口径：libs/image/tests/KisFourPointInterpolatorTest.cpp 全文 +
// 两个被测头）：`QPolygonF` 22 次、`operator<<` 每个多边形 4 次、
// `operator[]` 在 backward.h 的构造函数里 8 次、`boundingRect()` 2 次
// （测试第 205 行与第 270 行）。**at / size / value 一次都没有** —— 但 at/size
// 从 QVector 继承来是免费的，value 不做。
// ============================================================================
#include <QPointF>
#include <QRectF>
#include <QVector>

class QPolygonF : public QVector<QPointF>
{
public:
    QPolygonF() = default;
    QPolygonF(std::initializer_list<QPointF> args) : QVector<QPointF>(args) {}

    // Qt 5.15.7 qpolygon.cpp 的 QPolygonF::boundingRect()：空多边形返回
    // QRectF(0,0,0,0)，否则取四个分量的极值、用 (topLeft, bottomRight) 两点构造。
    //
    // Qt 原文写的是 `if (x < minx) minx = x; else if (x > maxx) maxx = x;`。
    // 这里写成两个独立 if，**取值完全相同**：循环开始时 minx == maxx == 首点，
    // 之后恒有 minx <= maxx，所以 `x < minx` 与 `x > maxx` 不可能同时成立，
    // else 分支永远吃不到东西。这不是"简化"，是等价改写，写在这里免得下一个人
    // 以为漏了 Qt 的什么讲究。
    QRectF boundingRect() const
    {
        if (isEmpty()) {
            return QRectF(0, 0, 0, 0);
        }

        qreal minx = (*this)[0].x();
        qreal maxx = minx;
        qreal miny = (*this)[0].y();
        qreal maxy = miny;

        for (int i = 1; i < size(); ++i) {
            const QPointF &p = (*this)[i];
            if (p.x() < minx) { minx = p.x(); }
            if (p.x() > maxx) { maxx = p.x(); }
            if (p.y() < miny) { miny = p.y(); }
            if (p.y() > maxy) { maxy = p.y(); }
        }

        return QRectF(QPointF(minx, miny), QPointF(maxx, maxy));
    }
};
