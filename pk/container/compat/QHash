//
// **代价**：用本垫片的目标必须把 `pk/string` 挂上 include 路径
// （PkStringHash.h → PkString.h）。**不需要链 pkstring**，除非真的实例化了
// PkHash<PkString, X>：qHash 是 inline，没用到就不生成任何符号 ——
// libpkcontainer.a 因此照样一个 pkstring 符号都不欠（判据③）。
#include "../PkStringHash.h"

// 兼容垫片：`#include <QHash>` → PkHash。形态与理由见 compat/QVector 的头注释。
#define QHash PkHash

