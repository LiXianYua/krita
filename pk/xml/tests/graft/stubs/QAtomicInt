//   ref() / deref()：Qt 语义——返回的是"新值"是否非零，不是旧值、不是成功与否
//   operator int() const（隐式转换）
//   fetchAndAddOrdered(int)：Qt 语义——返回**相加前**的旧值，跟 ref()/deref()
//                     的"新值"语义不同，别搞混
// 没有用到 load()/store()，因此没有加。
#include <atomic>

class QAtomicInt {
public:
    QAtomicInt(int v = 0) : _v(v) {}

    bool ref()   { return ++_v != 0; }
    bool deref() { return --_v != 0; }

    operator int() const { return _v.load(); }

    int fetchAndAddOrdered(int valueToAdd) { return _v.fetch_add(valueToAdd); }

private:
    std::atomic<int> _v;
};
