#pragma once
#include <cstdint>
#include <cmath>
#include "../PkTestCompare.h"

// Krita 测试与被测头用到的最小标量集合。**不实现 QtGlobal 的其余部分** ——
// 多实现一项就是一项没有调用点、没有测试压力、却要跟着 Qt 语义走的负债
// （线级 spec 判据①）。R-02/R-03 交付各自的类型时，这里的重叠部分应让给它们。
using qint8   = std::int8_t;
using quint8  = std::uint8_t;
using qint16  = std::int16_t;
using quint16 = std::uint16_t;
using qint32  = std::int32_t;
using quint32 = std::uint32_t;
using qint64  = std::int64_t;
using quint64 = std::uint64_t;
using qreal   = double;

template <typename T> constexpr T qAbs(const T &t) { return t >= T(0) ? t : -t; }
template <typename T> constexpr const T &qMin(const T &a, const T &b) { return a < b ? a : b; }
template <typename T> constexpr const T &qMax(const T &a, const T &b) { return a < b ? b : a; }

#define qFuzzyCompare pkFuzzyCompare
#define qFuzzyIsNull  pkFuzzyIsNull
