// 兼容垫片：让真实调用点的 `#include <QFlags>` 在**一个字都不改**的前提下解析到
// PkFlags。文件名刻意没有扩展名 —— 调用点写的就是 <QFlags>（Qt 5 的转发头）。
//
// 用宏而不是 using（形态与理由见 pk/container/compat/QVector 头注释：前置声明
// `class QFlags;` 会被宏改写成 `class PkFlags;`，照样成立）。
//
// 宏名用函数式（而非对象式 #define Q_DECLARE_FLAGS PK_DECLARE_FLAGS），
// 避免「对象式宏 + 再扫描」在函数式宏调用点上的歧义。
#pragma once
#include "../PkFlags.h"

// 保存调用点进入前这三个宏的状态（真 Qt 或未定义），供 real-Qt-first TU 在
// 消费完垫片后用 `#pragma pop_macro` 精确恢复，而不是被 #undef 直接删掉——
// Q_DECLARE_FLAGS/Q_DECLARE_OPERATORS_FOR_FLAGS 是函数式宏，真 Qt 的定义被本
// 垫片同名覆盖后，光 #undef 找不回（只剩未定义），pop_macro 才能还原。
#pragma push_macro("QFlags")
#pragma push_macro("Q_DECLARE_FLAGS")
#pragma push_macro("Q_DECLARE_OPERATORS_FOR_FLAGS")

#define QFlags PkFlags
#define Q_DECLARE_FLAGS(Flags, Enum) PK_DECLARE_FLAGS(Flags, Enum)
#define Q_DECLARE_OPERATORS_FOR_FLAGS(Flags) PK_DECLARE_OPERATORS_FOR_FLAGS(Flags)