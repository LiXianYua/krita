//
// 用量表（libs/image/tests/kis_shared_ptr_test.cpp:262 :283 实测确认，只加
// 真正用到的成员）：构造(T*)、data()、析构时释放。没有用到 reset()/operator->/
// operator*/operator bool，一个都没加。不可拷贝，避免误用导致的二次释放。
template <class T>
class QScopedPointer {
public:
    explicit QScopedPointer(T *p = nullptr) : _p(p) {}
    ~QScopedPointer() { delete _p; }

    QScopedPointer(const QScopedPointer &) = delete;
    QScopedPointer &operator=(const QScopedPointer &) = delete;

    T *data() const { return _p; }

private:
    T *_p;
};
