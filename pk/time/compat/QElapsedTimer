#pragma once
#include "../PkElapsedTimer.h"

// 兼容垫片：让真实调用点的 `#include <QElapsedTimer>` 在一个字不改的前提下
// 解析到 PkElapsedTimer。文件名刻意没有扩展名 —— 调用点写的就是
// <QElapsedTimer>。
//
// 用宏而不是 `using QElapsedTimer = PkElapsedTimer;`：与 pk/string/compat/
// QString、pk/geometry/compat/QRect 等先例同因——Krita 里可能存在
// `class QElapsedTimer;` 前置声明，类型别名遇到它会报
// "QElapsedTimer redeclared as different kind of entity"；宏则把那一行原样
// 改写成 `class PkElapsedTimer;`，前置声明照样成立。
//
// 真实调用点用到的 6 个 API（start/restart/elapsed/nsecsElapsed/isValid/
// invalidate）全部是无参或标量参数的成员函数，不涉及任何 `Qt::` 命名空间
// 限定名——不需要像 compat/QDateTime 那样额外补 `namespace Qt {...}`。
#define QElapsedTimer PkElapsedTimer
