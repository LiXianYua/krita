#include "KarbonToolsResources.h"

#include <mutex>

namespace
{
const unsigned char calligraphyIconPng[] = {
    @KARBON_CALLIGRAPHY_PNG_BYTES@
};

static_assert(sizeof(calligraphyIconPng) == @KARBON_CALLIGRAPHY_PNG_SIZE@,
              "generated calligraphy icon size mismatch");

std::mutex resourceRegistrarMutex;
KarbonToolsResourceRegistrar resourceRegistrar = nullptr;
enum class ResourceRegistrationState
{
    Ready,
    Delivering,
    Complete
};
ResourceRegistrationState resourceRegistrationState = ResourceRegistrationState::Ready;
}

KarbonToolsResource karbonCalligraphyIconPng()
{
    return {"calligraphy", ":/calligraphy.png", calligraphyIconPng, sizeof(calligraphyIconPng)};
}

bool setKarbonToolsResourceRegistrar(KarbonToolsResourceRegistrar registrar)
{
    std::lock_guard<std::mutex> lock(resourceRegistrarMutex);
    if (!registrar ||
        resourceRegistrationState != ResourceRegistrationState::Ready ||
        resourceRegistrar) {
        return false;
    }
    resourceRegistrar = registrar;
    return true;
}

void registerKarbonToolsResources()
{
    KarbonToolsResourceRegistrar registrar = nullptr;
    {
        std::lock_guard<std::mutex> lock(resourceRegistrarMutex);
        if (resourceRegistrationState != ResourceRegistrationState::Ready) {
            return;
        }
        resourceRegistrationState = ResourceRegistrationState::Delivering;
        registrar = resourceRegistrar;
    }

    if (registrar) {
        registrar(karbonCalligraphyIconPng());
    }

    std::lock_guard<std::mutex> lock(resourceRegistrarMutex);
    resourceRegistrationState = ResourceRegistrationState::Complete;
}
