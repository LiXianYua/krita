// Shell-local QRandomGenerator shim（S-06 ② 测试兼容）。
// Qt 语义：进程级随机源（global()）+ 可种子构造的确定性序列。壳里无 Qt，
// 用 std::mt19937 承载。测试里只把它当随机数据源（seed → bounded/generate），
// 不依赖 Qt 的具体序列值，std::mt19937 语义等价。
// Strip target: pk 提供随机源时替换。
#pragma once
#include "PkGlobal.h"   // quint32/quint64 等
#include <random>

class QRandomGenerator
{
public:
    QRandomGenerator()
        : m_gen(std::random_device{}())
    {
    }

    explicit QRandomGenerator(quint32 seed)
        : m_gen(seed)
    {
    }

    // Qt 语义：生成一个 32 位随机数。
    quint32 generate()
    {
        return static_cast<quint32>(m_gen());
    }

    // Qt 语义：[0, n) 内的随机整数。n == 0 时 Qt 断言；壳内按 0 返回 0。
    quint32 bounded(quint32 n)
    {
        return n == 0 ? 0 : static_cast<quint32>(m_gen() % n);
    }

    // Qt 语义：[lowest, highest) 内的随机整数（允许负数区间）。
    int bounded(int lowest, int highest)
    {
        if (lowest >= highest) {
            return lowest;
        }
        const unsigned long span = static_cast<unsigned long>(highest) - static_cast<unsigned long>(lowest);
        return lowest + static_cast<int>(m_gen() % span);
    }

    // Qt 语义：重新播种（kis_chunk_allocator_test 用 QTime::currentTime().msec() 做种子）。
    void seed(quint32 seed)
    {
        m_gen.seed(seed);
    }

    // Qt 语义：进程级单例随机源。
    static QRandomGenerator *global()
    {
        static QRandomGenerator s_global;
        return &s_global;
    }

private:
    std::mt19937 m_gen;
};
