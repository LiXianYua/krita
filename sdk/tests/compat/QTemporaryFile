#pragma once
#include "PkString.h"

#include <cstdlib>
#include <string>
#include <vector>
#include <unistd.h>

class QTemporaryFile
{
public:
    explicit QTemporaryFile(const PkString &templateName)
        : m_template(templateName.PkToUtf8())
    {
    }

    ~QTemporaryFile()
    {
        // 探针 §8：先 close（close 不删），再由析构按 autoRemove 删。
        close();
        if (m_autoRemove && !m_name.empty()) {
            ::unlink(m_name.c_str());
        }
    }

    QTemporaryFile(const QTemporaryFile &) = delete;
    QTemporaryFile &operator=(const QTemporaryFile &) = delete;

    // 真 Qt 语义：setAutoRemove 返回 void（不是 bool）。
    void setAutoRemove(bool b) { m_autoRemove = b; }

    // 真 Qt 语义：open() 前是空串（探针 §8）。
    PkString fileName() const { return PkString(m_name.c_str()); }

    bool open()
    {
        std::string tmpl = m_template;
        std::size_t marker = tmpl.find("XXXXXX");
        if (marker == std::string::npos) {
            // 真 Qt 追加 `.XXXXXX`（带点号）——探针实测 4/4，见文件头注（Task 3b N-6）。
            tmpl += ".XXXXXX";
            marker = tmpl.size() - 6;
        }

        std::vector<char> buf(tmpl.begin(), tmpl.end());
        buf.push_back('\0');
        const int suffixLen = static_cast<int>(tmpl.size() - (marker + 6));

        const int fd = ::mkstemps(buf.data(), suffixLen);
        if (fd < 0) {
            return false;
        }
        m_fd = fd;
        m_name.assign(buf.data());
        return true;
    }

    // 真 Qt 语义：close 只关 fd，**不删文件**（探针 §8）。
    void close()
    {
        if (m_fd >= 0) {
            ::close(m_fd);
            m_fd = -1;
        }
    }

private:
    std::string m_template;
    std::string m_name;
    int m_fd = -1;
    bool m_autoRemove = true; // 真 Qt 默认 true（探针 §8）
};
