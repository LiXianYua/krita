// Shell-local QTime shim（S-06 ② 测试兼容）。
// 测试里只用到 QTime::currentTime().msec() 作随机种子，不依赖具体时刻语义；
// 这里用 std::chrono 取当前时间的毫秒分量（0-999，与 Qt QTime::msec() 口径一致）。
// Strip target: pk/time 提供 PkTime 后替换。
#pragma once
#include "PkGlobal.h"
#include <chrono>

class QTime
{
public:
    static QTime currentTime()
    {
        using namespace std::chrono;
        const auto now = system_clock::now().time_since_epoch();
        const auto ms = duration_cast<milliseconds>(now).count();
        QTime t;
        t.m_msec = static_cast<int>(ms % 1000);
        return t;
    }

    // Qt 语义：当前时刻的毫秒分量（0-999）。
    int msec() const
    {
        return m_msec;
    }

private:
    int m_msec = 0;
};
