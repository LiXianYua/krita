#pragma once
// ---------------------------------------------------------------------------
// R-65 T2+4 增补：真 Qt 5.15 的 <QDir> **传递**声明 QFileInfo（qdir.h 里
// `typedef QList<QFileInfo> QFileInfoList;` 需要完整类型），实测探针：
//   /usr/bin/c++ -std=c++17 -F"$QT/lib" -I"$QT/lib/QtCore.framework/Headers" \
//       -fsyntax-only t.cpp        # t.cpp = `#include <QDir>` + `QFileInfo f(...)`
//   → rc=0（通过）
//   对照：只 include <QApplication> 时同一份 t.cpp → `unknown type name 'QFileInfo'`
// 而 sdk/tests/qimage_test_util.h 的 FILES_OUTPUT_DIR 块只 include
// <QProcessEnvironment>/<QDir>/<QApplication> 就直接用 QFileInfo（:60,69,74,78,83）。
// 所以本垫片按真 Qt 的传递面补上这条边——否则 pk 栈报 `use of undeclared
// identifier 'QFileInfo'`（7 个 target）。仅补真实传递面，不多给。
// 唯一真实受益调用点：sdk/tests/qimage_test_util.h:60,69,74,78,83。
// ---------------------------------------------------------------------------
#include "PkString.h"
#include "QFileInfo"
#include "PkGlobal.h"
#include "PkPathClean.h"
#include <sys/stat.h>
#include <unistd.h>
#include <climits>
#include <cstdlib>
#include <string>
#include <dirent.h>
#include "PkList.h"

class QDir {
public:
    QDir() {}
    QDir(const PkString& path) : m_path(path.PkToUtf8()) {}

    // Qt 语义：当前工作目录的绝对路径（QDir::currentPath() 是 static）。
    // 取不到时返回空串（Qt 在同样情形下也退化，不抛）。
    static PkString currentPath() {
        char buf[PATH_MAX];
        if (getcwd(buf, sizeof(buf)) == nullptr) {
            return PkString();
        }
        return PkString(buf);
    }

    bool exists() const {
        struct stat st;
        return stat(m_path.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
    }

    // R-77 增补。真 Qt 5.15.7 探针实测（task1-report.md §3.2 的 §9d）：
    //   TMPDIR = '/var/folders/…/T/'（带尾斜杠）
    //   QDir::tempPath() = '/private/var/folders/…/T'
    // 即真 Qt **去尾斜杠 + 走 realpath**（macOS 上 /var 是指向 /private/var 的符号
    // 链接，两者不同串——所以这里必须 realpath，不能只 cleanPath）。
    // TMPDIR 未设时的退化分支（**修复轮 2 真探针实测**，Task 3b N-6）：修复轮 1 曾标
    // 「已实测」，但 `run_oracle.sh` 里**没有** `env -u TMPDIR` 这一遍、输出也没有归档
    // —— 复审 N-6 判阻塞。本轮补上：`run_oracle.sh` 现跑**两遍**（第二遍 `env -u TMPDIR`），
    // 探针 §9f/§9d 逐遍打印取值，原始输出归档在
    // `.superpowers/sdd/R-77/evidence/fix2-oracle.txt`。第二遍实测：
    //   `getenv(TMPDIR) = '(unset)'`，`QDir::tempPath() = '/private/var/folders/…/T'`
    //   （= 本机 launchd 设的那个 per-user 临时目录的 realpath），**不是 `/tmp`**。
    // 旧稿「退化成 /tmp（真 Qt 同款）」那句是**错的**（无探针支持的推断）。
    // 本垫片仍退化成 `/tmp`，属**已知的行为分歧**，
    // 保留理由：(a) 该分支只在 `TMPDIR` **未设**时才走到，而本机 `TMPDIR` 由 launchd 恒设；
    //     pk 栈上唯一的 `QDir::tempPath()` 调用点是 R-77 自己的自测
    //     `sdk/tests/PkTestSupportSelfTest.cpp:153`，它同样跑在 launchd 设了 `TMPDIR` 的环境里
    //     （**修复轮 2 订正**：此处原文写「pk 栈零个 `QDir::tempPath()` 调用点」，与 R-77 自己
    //      的自测矛盾 —— 现场 `grep -rn 'tempPath' sdk libs plugins pk` 证实那个自测就是
    //      pk 栈调用点）；真正的**业务**调用点 `plugins/impex/exr/tests/kis_exr_test.cpp:58`
    //     在**真 Qt 栈**，不进本垫片（`plugins/impex/` 不定义 `KRITA_TESTSDK_PK_NATIVE`）；
    // (b) `/tmp` 是 POSIX 的通用临时目录，作垫片回退足够，且比 confstr(_CS_DARWIN_USER_TEMP_DIR)
    // 少一处平台耦合。分歧本身已按纪律登记（不是未实测的分支了）。
    // 业务调用点（**真 Qt 栈**）：plugins/impex/exr/tests/kis_exr_test.cpp:58（修复轮 1 订正，Task 3b N-8）。
    static PkString tempPath() {
        const char *tmp = std::getenv("TMPDIR");
        std::string base = (tmp && *tmp) ? tmp : "/tmp";
        while (base.size() > 1 && base.back() == '/') {
            base.pop_back();
        }
        char resolved[PATH_MAX];
        if (realpath(base.c_str(), resolved) != nullptr) {
            return PkString(resolved);
        }
        return PkString(base.c_str());
    }

    // R-77 增补。真 Qt 5.15.7 的 18 个边角用例逐条对齐（task1-report.md §3.2 的
    // §9e），算法本体在 PkPathClean.h（与 QFileInfo::absoluteFilePath 共用，
    // 唯一的差别是这里**不保留**尾斜杠：`/a/b/` → `/a/b`）。
    // 调用点：sdk/tests/filestest.h:261（端口化后的 impexTempFilesDir() 函数体内；函数自 :259 起）。
    static PkString cleanPath(const PkString &path) {
        return PkString(pkCleanPath(path.PkToUtf8(), false).c_str());
    }

    // 真 Qt 语义：`dirPath` 是**相对路径**时相对于本 QDir 的目录；`"."` 即本目录
    // 自身。探针 §1 已实测并钉死这一点（task1-report.md §3.2）：
    //   `QDir("/tmp/pk_probe_mkpath/x/y").mkpath(".")` 返回 1，且随后
    //   `QDir("/tmp/pk_probe_mkpath/x/y").exists()` == 1 —— 即**创建的是 QDir 自己
    //   那个目录**，不是 cwd 下的 "."。
    //
    // R-77 修：此前这里直接 `mkdir(dirPath)`、完全忽略 m_path，于是
    // `QDir(path).mkpath(".")` 只做了一次 `mkdir(".")`（EEXIST，且 mkpath_recursive
    // 恒返回 true ⇒ 静默"成功"），真 Qt 语义下该创建的 `path` 根本没被创建。
    // 第一个把这条语义暴露出来的真实调用点是 R-77 端口化后的
    // `sdk/tests/filestest.h:263` 的 `QDir(path).mkpath(QStringLiteral("."))`。
    //
    // 绝对路径不受影响，因此既有消费者逐字不变：`sdk/tests/qimage_test_util.h:279-280`
    // 用的是**默认构造**的 QDir（m_path 空）+ 绝对路径，走不到上面那个分支。
    bool mkpath(const PkString& dirPath) const {
        std::string p = dirPath.PkToUtf8();
        if (!p.empty() && p[0] != '/' && !m_path.empty()) {
            p = m_path + "/" + p;
        }
        return mkpath_recursive(pkCleanPath(p, false));
    }

    static bool mkpath_recursive(const std::string& path) {
        if (path.empty()) return false;
        std::string p;
        size_t i = 0;
        if (path[0] == '/') { p = "/"; i = 1; }
        for (; i < path.size(); ++i) {
            if (path[i] == '/') {
                if (p != "/" && !p.empty()) mkdir(p.c_str(), 0777);
            }
            p += path[i];
        }
        mkdir(p.c_str(), 0777);
        return true;
    }
    // R-82 增补。语义与口径见本文件头注的 R-82 段（真 Qt 5.15.7 探针实测）。
    // 返回 `.`、`..` 与全部**非隐藏**条目，顺序 = readdir 顺序。
    PkList<QFileInfo> entryInfoList() const
    {
        PkList<QFileInfo> result;
        const std::string dirPath = m_path.empty() ? std::string(".") : m_path;
        DIR *dir = opendir(dirPath.c_str());
        if (dir == nullptr) {
            return result;
        }
        while (struct dirent *entry = readdir(dir)) {
            const char *name = entry->d_name;
            const bool isDotOrDotDot =
                    name[0] == '.' && (name[1] == '\0' || (name[1] == '.' && name[2] == '\0'));
            if (name[0] == '.' && !isDotOrDotDot) {
                continue; // 点开头 = hidden（探针：.hidden.txt 不出现）
            }
            const std::string full = dirPath + "/" + name;
#ifdef UF_HIDDEN
            // 探针 probe2：UF_HIDDEN 的条目同样被排除（列 `/` 时 `tmp` 不出现）。
            if (!isDotOrDotDot) {
                struct stat st;
                if (lstat(full.c_str(), &st) == 0 && (st.st_flags & UF_HIDDEN)) {
                    continue;
                }
            }
#endif
            result.append(QFileInfo(PkString(full.c_str())));
        }
        closedir(dir);
        return result;
    }

private:
    std::string m_path;
};
