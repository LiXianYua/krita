// ---------------------------------------------------------------------------
// 为什么测试面需要它：`pk/` 树无 QFileInfo（`ls pk/*/compat/QFileInfo` 实测无），
// 而 sdk/tests/qimage_test_util.h 的 `#ifdef FILES_OUTPUT_DIR` 块要用它。
// 唯一的真实调用点：
//   sdk/tests/qimage_test_util.h:60,69,78  `if (QFileInfo(filename).exists())`
//   sdk/tests/qimage_test_util.h:74,83     `QFileInfo(qApp->applicationFilePath()).absolutePath() + "/" + …`
// 语义（**真 Qt 探针实测**，原始输出 evidence/t24/probe_qfileinfo-output.txt，
//       Qt 5.15.7 / macOS）：
//   * `exists()` 对**文件与目录**都返回 true（"/etc/hosts" 与 "/etc" 都 true、
//     "/no/such/file" false）。
//   * `absolutePath()` = 把路径按「最后一段是文件名」理解后取**其父目录的绝对路径**：
//     `/a/b/c.png` → `/a/b`；相对路径 `c.png` → 先按 cwd 解析，取父目录 = **cwd 本身**。
// 本垫片逐条对齐（exists 用 stat、目录也算；absolutePath 先 absolutize 再取 dirname）。
//
// R-75 增补 `path()`（见下）：打开 sdk/tests/qimage_test_util.h 的 checkQImage 族
// 后，`QFileInfo pathInfo(path); directory.mkpath(pathInfo.path());` 成为新调用点。
//
// 归属：QFileInfo 属 PkImage 文件 I/O（R-15）那一族；`sdk/tests/qimage_test_util.h`
// 已是登记的 [GAP]（关闭条件 = R-15 交付 PkImage 文件 I/O —— **R-75 已满足**）。
// 本垫片只覆盖上述唯一调用点所需的最小 API（构造/exists/absolutePath/path()），
// 一路一项不多。
// ---------------------------------------------------------------------------
// R-77 增补 `absoluteFilePath()` 与 `permissions()`（见类内两处注释）。两者的真 Qt
// 语义都由 pk/test/oracle/probe_file_shims.cpp 实测钉死，原始输出见 task1-report.md
// §3.2。**impact-map §2 的用量表里没有这两项** —— 它们是从 filestest.h 的真实调用点
// 反查出来的缺口，已在 task1-report.md **§11 第 5 条**（「缺口 / 取舍登记」）与
// impact-map **§2.1**（表外实测新增）登记。
// （修复轮 1 订正：旧稿写的「报告 §5」在该报告里是「判据⑤ 改动路径闭包」，
//  指向不存在；Task 3b N-10。）
#pragma once
#include "PkString.h"
#include "QFile"
#include "PkPathClean.h"
#include <sys/stat.h>
#include <unistd.h>
#include <climits>
#include <string>

class QFileInfo
{
public:
    explicit QFileInfo(const PkString &path)
        : m_path(path.PkToUtf8())
    {
    }

    // 文件或目录存在即 true（探针实测）。
    bool exists() const
    {
        struct stat st;
        return stat(m_path.c_str(), &st) == 0;
    }

    // R-75 增补 `path()` —— 唯一调用点 sdk/tests/qimage_test_util.h 的
    //   `QFileInfo pathInfo(path); directory.mkpath(pathInfo.path());`
    // 语义（**真 Qt 5.15.7 探针实测**，原始输出见 R-75 task-2 报告 §3.3，
    //      探针源码 /tmp/r75probe2/qfileinfo_probe*.cpp，Qt 5.15.7 / macOS）：
    //   "/a/b/c.png"→"/a/b" · "a/b/c.png"→"a/b"（**相对保持相对**）
    //   "c.png"→"." · "plain"→"." · ".."→"." · "."→"."
    //   "/c.png"→"/" · "//c.png"→"/" · ""（空）→""
    //   "a/b//"→"a/b/" · "a/b///"→"a/b//" · "a//b//c.png"→"a//b/"
    //   "/a/./b/../c.png"→"/a/./b/.."（**不**做 cleanPath 归一）
    // 即：空串原样返回；否则取**最后一个 '/' 左侧**；lastIndexOf==0 → "/"；
    // lastIndexOf<0 → "."。**与 absolutePath() 的区别**：path() 对相对路径
    // **保持相对**（"a/b/c.png"→"a/b"，不按 cwd 绝对化），absolutePath() 先按
    // cwd 绝对化再取父目录（"a/b/c.png"→"<cwd>/a/b"）。两者实现不可混抄。
    PkString path() const
    {
        if (m_path.empty()) {
            return PkString();
        }
        const std::size_t slash = m_path.find_last_of('/');
        if (slash == std::string::npos) {
            return PkString(".");
        }
        if (slash == 0) {
            return PkString("/");
        }
        return PkString(m_path.substr(0, slash).c_str());
    }

    // 父目录的绝对路径；相对路径按 cwd 解析（探针实测：`c.png` → cwd）。
    PkString absolutePath() const
    {
        std::string abs = m_path;
        if (abs.empty() || abs[0] != '/') {
            char buf[PATH_MAX];
            if (getcwd(buf, sizeof(buf)) == nullptr) {
                return PkString();
            }
            abs = std::string(buf) + "/" + abs;
        }
        const std::size_t slash = abs.find_last_of('/');
        if (slash == std::string::npos) {
            return PkString();
        }
        if (slash == 0) {
            return PkString("/"); // "/x" → "/"
        }
        return PkString(abs.substr(0, slash).c_str());
    }

    // R-77 增补。真 Qt 5.15.7 探针实测 18 个边角用例（task1-report.md §3.2 的 §7b）：
    //   "a/b/c.png"→"<cwd>/a/b/c.png" · "a/../b"→"<cwd>/b" · ""→""（空串原样）
    //   "/a/b/../c"→"/a/c" · "./x"→"<cwd>/x" · "x/./y"→"<cwd>/x/y"
    //   ".."→"<cwd 父>" · "."→"<cwd>" · "a//b"→"<cwd>/a/b" · "//a"→"/a"
    //   "/../a"→"/../a"（越根 ".." 保留）· "/a/./b"→"/a/b" · "/a/b/.."→"/a"
    //   "a/b/.."→"<cwd>/a" · "/a/../../b"→"/../b"
    //   **尾斜杠保留**（与 QDir::cleanPath 的唯一差别）：
    //   "/a/b/"→"/a/b/" · "a/b/"→"<cwd>/a/b/" · "a/b/../"→"<cwd>/a/"
    // 即：先按 cwd 绝对化（已是绝对路径则不碰），再走 PkPathClean.h 的清理，
    // keepTrailingSlash=true。
    // 调用点：sdk/tests/filestest.h:214,217,237,239,252,254,…（prepareFile /
    // restorePermissionsToReadAndWrite / testImportFromWriteonly 族）。
    PkString absoluteFilePath() const
    {
        if (m_path.empty()) {
            return PkString();
        }
        std::string abs = m_path;
        if (abs[0] != '/') {
            char buf[PATH_MAX];
            if (getcwd(buf, sizeof(buf)) == nullptr) {
                return PkString();
            }
            abs = std::string(buf) + "/" + abs;
        }
        return PkString(pkCleanPath(abs, true).c_str());
    }

    // R-77 增补。语义（探针 §7 实测）：与 `QFile::permissions(路径)` 逐位相同
    // （存在文件 = 真实位模式，含 exe 位；不存在 = 0）⇒ 直接委托 `QFile`，
    // 不在这里重写一遍位映射（位映射只有一处，在 compat/QFile 的 permissionsOf）。
    // 注意**不用** absoluteFilePath() 中转：stat 对相对路径本来就以 cwd 为基准，
    // 走原始路径少一层函数、也少一条 absoluteFilePath 边角规则的耦合。
    // 调用点：sdk/tests/filestest.h:246（restorePermissionsToReadAndWrite）。
    QFileDevice::Permissions permissions() const
    {
        return QFile::permissions(PkString(m_path.c_str()));
    }

private:
    std::string m_path;
};
